# Discord bot application token (Developer Portal > Bot > Token)
DISCORD_BOT_TOKEN=

# The Salesforce Amritapuri server's ID (enable Developer Mode, right-click server icon > Copy Server ID)
DISCORD_GUILD_ID=

# The #status-updates channel ID (right-click channel > Copy Channel ID)
STATUS_UPDATES_CHANNEL_ID=

# Name of the Discord role that counts as "lead" (case-insensitive). Must already exist on the server.
LEAD_ROLE_NAME=Lead

# Supabase project (service_role key only — this bot bypasses RLS by design, never expose it client-side)
SUPABASE_URL=https://cjbgciaiitnnhjvwgggz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gmail account used to send OTP verification codes via SMTP.
# Requires 2-Step Verification enabled on this Google account, and an App Password
# generated at https://myaccount.google.com/apppasswords (NOT your normal Gmail password).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=Salesforce Amritapuri Status Bot

# How long a /register code stays valid, and how many wrong /verify attempts are allowed
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# IANA timezone used for the 9 PM reminder and the 12 AM missed-update report
TIMEZONE=Asia/Kolkata

LOG_LEVEL=INFO
